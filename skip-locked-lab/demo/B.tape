# Records Terminal B. Run both tapes at the same time: see record.sh
Output B.mp4
Set Shell bash
Set FontSize 14
Set Width 780
Set Height 440
Set Padding 16
Set Framerate 15
Set TypingSpeed 30ms
Hide
Type "cd ../worker-cs && clear"
Enter
Show
Type "# Terminal B"
Enter
Sleep 1500ms
Type "dotnet run --project src/App -- B"
Enter
Sleep 32s
